# Native macOS development overrides.
# This file is layered after .env by scripts/dev-macos, so local service
# addresses and safety gates win without changing production configuration.

APP_ENV=development
DATABASE_URL=postgresql+psycopg://stock:stock@127.0.0.1:5432/stock_monitor
REDIS_URL=redis://127.0.0.1:6379/15
BIND_ADDRESS=127.0.0.1

ADMIN_USERNAME=admin
ADMIN_INIT_PASSWORD=stock-monitor-local-dev
JWT_SECRET=stock-monitor-local-development-only-secret

FINNHUB_MCP_URL=http://127.0.0.1:8125/mcp
PI_AGENT_BASE_URL=http://127.0.0.1:3001
BACKEND_BASE_URL=http://127.0.0.1:8000
PI_AGENT_HOST=127.0.0.1
NO_PROXY=127.0.0.1,localhost,::1
no_proxy=127.0.0.1,localhost,::1

# Playwright's native arm64 Chromium is used locally. Production keeps the
# /usr/bin/chromium default from backend/app/config.py.
ARTICLE_FETCH_BROWSER_EXECUTABLE=

# Never let a copied production .env make local background processes contact
# IBKR or execution endpoints. These integrations remain production-only and
# fail closed through the VPS proxy.
IBKR_CP_ENABLED=false
IBKR_FLEX_ENABLED=false
IBKR_FLEX_AUTO_SYNC_ENABLED=false
EXECUTION_CONTROL_ENABLED=false

# Native development starts only explicitly requested providers. The safe
# local beat configuration does not run the production schedule.
REALTIME_STREAM_ENABLED=false
ALPACA_MARKET_DATA_ENABLED=false
TIINGO_MARKET_DATA_ENABLED=false
TIINGO_NEWS_ENABLED=false
CRYPTO_PUBLIC_ENABLED=false
CRYPTO_COINGECKO_ENABLED=false
CRYPTO_QUANT_ENABLED=false
QUANT_SIGNAL_ENABLED=false
QUANT_PAPER_ENABLED=false
ALPHA_VANTAGE_ENABLED=false
EXA_ENABLED=false
PERPLEXITY_LIVE_EVALUATION_ENABLED=false
MARKETAUX_ENABLED=false
MARKET_NEWS_ENABLED=false
FINNHUB_MARKET_NEWS_ENABLED=false
MARKETAUX_MARKET_NEWS_ENABLED=false
FMP_ENABLED=false
FMP_SYNC_ENABLED=false
FMP_PROFILE_SYNC_ENABLED=false
FMP_PRICE_SYNC_ENABLED=false
FMP_TRANSLATION_ENABLED=false
INDUSTRY_PULSE_ENABLED=false
INDUSTRY_PULSE_AI_ENABLED=false
OPTIONS_ENABLED=false
AI_ENABLED=false

# Set to .env.macos in the untracked local file if local-only overrides are
# needed. Runtime data paths are derived from the checkout by macos_env.py.
STOCK_MONITOR_LOCAL_DATA_DIR=.local/data
