POSTGRES_DB=stock_monitor
POSTGRES_USER=stock
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://stock:change-me@postgres:5432/stock_monitor
REDIS_URL=redis://redis:6379/0
TAVILY_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_SIMPLE=gpt-5.4-mini
MODEL_MEDIUM=gpt-5.6-luna
MODEL_IMPORTANT=gpt-5.6-sol
PERPLEXITY_API_KEY=
PERPLEXITY_AGENT_MODEL=openai/gpt-5.4
PERPLEXITY_MAX_STEPS=5
PERPLEXITY_MAX_OUTPUT_TOKENS=12000
PERPLEXITY_ENABLE_WEB_SEARCH=true
PERPLEXITY_DISCOVERY_INTERVAL_DAYS=3
PERPLEXITY_MAX_MONTHLY_BUDGET_USD=10
PERPLEXITY_MAX_RUN_COST_USD=1
# 仅限显式、受预算控制的模型评估；普通测试永远不会调用真实 API
PERPLEXITY_LIVE_EVALUATION_ENABLED=false
PERPLEXITY_EVALUATION_BUDGET_USD=2
TRANSLATION_API_KEY=
TRANSLATION_BASE_URL=https://www.right.codes/claude-aws/v1
TRANSLATION_MODEL=claude-haiku-4-5-20251001
TRANSLATION_BATCH_SIZE=20
TRANSLATION_MAX_ATTEMPTS=3
MARKET_TIMEZONE=America/New_York
PRICE_POLL_MINUTES=5
DEFAULT_THRESHOLD_20M=2.0
DEFAULT_THRESHOLD_1H=4.0
DEFAULT_THRESHOLD_DAY=6.0
ALERT_COOLDOWN_MINUTES=60
INVESTIGATION_INTERVAL_MINUTES=20
INVESTIGATION_DURATION_MINUTES=120
EARNINGS_LOOKAHEAD_DAYS=7
FINNHUB_API_KEY=
FINNHUB_MCP_URL=http://finnhub-mcp:8125/mcp
FINNHUB_RATE_LIMIT_RPM=30
ARCHIVE_DIR=/data/archive
NEWS_POLL_MINUTES=15
MARKETAUX_API_KEY=
MARKETAUX_ENABLED=true
MARKETAUX_MAX_REQUESTS_PER_DAY=100
MARKETAUX_BATCH_SIZE=5
MARKET_NEWS_ENABLED=true
FINNHUB_MARKET_NEWS_ENABLED=true
MARKETAUX_MARKET_NEWS_ENABLED=true
MARKET_NEWS_POLL_MINUTES=60
MARKETAUX_MARKET_REQUESTS_RESERVE=12
MARKET_NEWS_MAX_ITEMS=20
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com/stable
FMP_REQUEST_TIMEOUT_SECONDS=15
FMP_DAILY_REQUEST_LIMIT=150
FMP_REQUEST_RESERVE=10
FMP_SYNC_ENABLED=true
FMP_PROFILE_SYNC_ENABLED=true
FMP_PRICE_SYNC_ENABLED=true
FMP_TRANSLATION_ENABLED=true
FMP_PROFILE_REFRESH_DAYS=180
TECHNICAL_CHART_DIR=/data/technical-charts
SITE_DOMAIN=stocks.example.com
AUTH_USER=admin
AUTH_PASSWORD_HASH=
