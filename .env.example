POSTGRES_DB=stock_monitor
POSTGRES_USER=stock
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://stock:change-me@postgres:5432/stock_monitor
REDIS_URL=redis://redis:6379/0
TAVILY_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_SIMPLE=gpt-5.4-mini
MODEL_MEDIUM=gpt-5.6-luna
MODEL_IMPORTANT=gpt-5.6-sol
# Automatic one-shot fallbacks: Luna -> Haiku, Sol -> Opus, Terra -> Sonnet.
PERPLEXITY_API_KEY=
PERPLEXITY_SEARCH_URL=https://api.perplexity.ai/search
PERPLEXITY_AGENT_URL=https://api.perplexity.ai/v1/agent
PERPLEXITY_AGENT_MODEL=openai/gpt-5.4
PERPLEXITY_MAX_STEPS=5
PERPLEXITY_MAX_OUTPUT_TOKENS=12000
PERPLEXITY_ENABLE_WEB_SEARCH=true
PERPLEXITY_MAX_MONTHLY_BUDGET_USD=10
PERPLEXITY_MAX_RUN_COST_USD=1
# 仅限显式、受预算控制的模型评估；普通测试永远不会调用真实 API
PERPLEXITY_LIVE_EVALUATION_ENABLED=false
PERPLEXITY_EVALUATION_BUDGET_USD=2
# Exa Agent 深度研究；通过 Exa Connect 自动挂载 financial_datasets
EXA_API_KEY=
EXA_AGENT_URL=https://api.exa.ai/agent/runs
EXA_AGENT_BETA=agent-2026-05-07
EXA_AGENT_EFFORT=high
EXA_AGENT_POLL_INTERVAL_SECONDS=4
EXA_AGENT_TIMEOUT_SECONDS=900
# Pi Agent 智能研究引擎（discovery_mode=pi_agent）。AGENT_GATEWAY_TOKEN 是
# sidecar 与后端之间的服务间令牌：留空时 pi_agent 引擎不可用；
# /api/agent/ 已在 nginx 层拒绝公网访问，不要开放。
AGENT_GATEWAY_TOKEN=
# 留空则使用 MODEL_IMPORTANT
PI_AGENT_MODEL=
PI_AGENT_MAX_TURNS=40
PI_AGENT_MAX_WEB_SEARCH_CALLS=15
PI_AGENT_DEEP_EFFORT=medium
PI_AGENT_TIMEOUT_SECONDS=900
ADANOS_API_KEY=
# 最多两个 Key，按顺序固定为：首个直连；首个 429 后第二个仅走 SOCKS5h 代理
ADANOS_API_KEYS=
ADANOS_API_BASE_URL=https://api.adanos.org
ADANOS_PROXY_URL=socks5h://host.docker.internal:10808
ADANOS_REQUEST_TIMEOUT_SECONDS=5
TRANSLATION_API_KEY=
TRANSLATION_BASE_URL=https://www.right.codes/claude-aws/v1
TRANSLATION_MODEL=claude-haiku-4-5-20251001
TRANSLATION_BATCH_SIZE=20
TRANSLATION_MAX_ATTEMPTS=3
MARKET_TIMEZONE=America/New_York
MOOD_EOD_START_HOUR=18
MOOD_EOD_FINALIZE_HOUR=23
PRICE_POLL_MINUTES=5
PRICE_SNAPSHOT_PROVIDER_ORDER=alpaca,tiingo,finnhub,yfinance
PRICE_SNAPSHOT_STALE_SECONDS=900
# Industry/Sector Pulse: persisted low-frequency analysis; no page-load provider calls.
INDUSTRY_PULSE_ENABLED=true
INDUSTRY_PULSE_REFRESH_HOURS=20
INDUSTRY_PULSE_HISTORY_DAYS=500
INDUSTRY_PULSE_BACKFILL_DAYS=252
INDUSTRY_PULSE_PROVIDER_TIMEOUT_SECONDS=30
INDUSTRY_PULSE_EXPOSURE_THRESHOLD=0.30
INDUSTRY_PULSE_LIQUIDITY_FLOOR=0.05
INDUSTRY_PULSE_SYNC_LOCK_SECONDS=7200
INDUSTRY_PULSE_AI_ENABLED=true
INDUSTRY_PULSE_SCORE_WEIGHTS={"trend":0.25,"relative_strength":0.25,"volume":0.15,"momentum":0.10,"breadth":0.15,"consensus":0.10}
OPTIONS_ENABLED=true
OPTIONS_REFRESH_HOURS=6
OPTIONS_PROVIDER_TIMEOUT_SECONDS=20
OPTIONS_CHAIN_CACHE_HOURS=12
OPTIONS_SYNC_LOCK_SECONDS=3600
OPTIONS_HISTORY_DAYS=365
# Alpaca Paper Trading API credentials are server-only. The same API key/secret
# authenticate Market Data, while the Trading API base URL is reserved for an
# optional credential smoke test. Portfolio authority remains IBKR.
ALPACA_MARKET_DATA_ENABLED=false
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_TRADING_ENV=paper
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_MARKET_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_MARKET_DATA_STREAM_URL=wss://stream.data.alpaca.markets
ALPACA_MARKET_DATA_FEED=iex
# Alpaca Basic/Paper accounts allow 30 channel-symbol subscriptions; set 0 for an unlimited plan.
ALPACA_MARKET_DATA_SYMBOL_LIMIT=30
TIINGO_MARKET_DATA_ENABLED=false
TIINGO_API_TOKEN=
TIINGO_MARKET_DATA_BASE_URL=https://api.tiingo.com
TIINGO_MARKET_DATA_STREAM_URL=wss://api.tiingo.com
TIINGO_REALTIME_MODE=consolidated
REALTIME_PROVIDER_ORDER=alpaca,tiingo,finnhub,yfinance
REALTIME_QUOTE_TTL_SECONDS=180
REALTIME_STALE_SECONDS=45
REALTIME_SUBSCRIPTION_REFRESH_SECONDS=30
REALTIME_PRICE_DIVERGENCE_WARN_PCT=0.5
REALTIME_STREAM_ENABLED=false
REALTIME_SSE_HEARTBEAT_SECONDS=15
REALTIME_EVENT_COOLDOWN_SECONDS=300
TIINGO_NEWS_ENABLED=false
TIINGO_NEWS_BATCH_SIZE=10
TIINGO_NEWS_POLL_MINUTES=15
TIINGO_NEWS_REQUEST_TIMEOUT_SECONDS=15
TIINGO_NEWS_LOOKBACK_HOURS=48
TIINGO_NEWS_LIMIT=100
DEFAULT_THRESHOLD_20M=2.0
DEFAULT_THRESHOLD_1H=4.0
DEFAULT_THRESHOLD_DAY=6.0
ALERT_COOLDOWN_MINUTES=60
INVESTIGATION_INTERVAL_MINUTES=20
INVESTIGATION_DURATION_MINUTES=120
EARNINGS_LOOKAHEAD_DAYS=7
FINNHUB_API_KEY=
FINNHUB_MCP_URL=http://finnhub-mcp:8125/mcp
FINNHUB_RATE_LIMIT_RPM=30
ARCHIVE_DIR=/data/archive
NEWS_POLL_MINUTES=15
MARKETAUX_API_KEY=
MARKETAUX_ENABLED=true
MARKETAUX_MAX_REQUESTS_PER_DAY=100
MARKETAUX_BATCH_SIZE=5
MARKET_NEWS_ENABLED=true
FINNHUB_MARKET_NEWS_ENABLED=true
MARKETAUX_MARKET_NEWS_ENABLED=true
MARKET_NEWS_POLL_MINUTES=60
MARKETAUX_MARKET_REQUESTS_RESERVE=12
MARKET_NEWS_MAX_ITEMS=20
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com/stable
FMP_REQUEST_TIMEOUT_SECONDS=15
FMP_DAILY_REQUEST_LIMIT=150
FMP_REQUEST_RESERVE=10
FMP_SYNC_ENABLED=true
FMP_PROFILE_SYNC_ENABLED=true
FMP_PRICE_SYNC_ENABLED=true
FMP_TRANSLATION_ENABLED=true
FMP_PROFILE_REFRESH_DAYS=180
TECHNICAL_CHART_DIR=/data/technical-charts
# 多个域名使用英文逗号和空格分隔；也兼容旧的 SITE_DOMAIN 变量
SITE_DOMAINS="stocks.example.com, www.stocks.example.com"
# Fail-closed auth: production (APP_ENV unset or =production) refuses to start
# without a strong random JWT_SECRET. Generate one with: openssl rand -base64 48
JWT_SECRET=
# dev/development/local/test allow the insecure default secret; never in production.
APP_ENV=
# Optional short-lived access tokens once all clients refresh; unset keeps the
# legacy 7/30-day behaviour for web compatibility.
ACCESS_TOKEN_TTL_MINUTES=
# Required only when the database has no admin user yet; startup refuses to
# bootstrap one from a source-code default password.
ADMIN_USERNAME=admin
ADMIN_INIT_PASSWORD=
AUTH_USER=admin
AUTH_PASSWORD_HASH=
# Read-only AI tool adapter/debug layer (does not call any model provider)
AI_TOOLS_ENABLED=true
AI_TOOLS_DEBUG_API_ENABLED=true
AI_TOOLS_BATCH_API_ENABLED=true
AI_TOOLS_DEFAULT_TIMEOUT_SECONDS=15
AI_TOOLS_MAX_TIMEOUT_SECONDS=30
AI_TOOLS_MAX_CALLS_PER_BATCH=12
AI_TOOLS_MAX_PARALLEL_CALLS=4
AI_TOOLS_COMPACT_MAX_CHARS=8000
AI_TOOLS_STANDARD_MAX_CHARS=24000
AI_TOOLS_DETAILED_MAX_CHARS=60000
AI_TOOLS_HARD_MAX_CHARS=80000
AI_TOOLS_CACHE_ENABLED=true
AI_TOOLS_AUDIT_ENABLED=true
# Optional comma-separated stable tool names to disable at startup.
AI_TOOLS_DISABLED_TOOLS=

# Stateless AI Orchestrator. AI_API_BASE/AI_API_KEY intentionally do not fall
# back to browser input; set them server-side to enable /api/ai/v1/respond.
AI_ENABLED=true
AI_PROVIDER=openai_compatible
AI_MODEL=gpt-5.6-sol
# Empty exposes TRANSLATION_MODEL, MODEL_*, gpt-5.6-terra,
# claude-opus-5, and claude-sonnet-4-6 through their family endpoints.
AI_ALLOWED_MODELS=
AI_API_BASE=
AI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=90
AI_TOTAL_TIMEOUT_SECONDS=120
AI_CONNECT_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=2
AI_MAX_MODEL_ROUNDS=5
AI_MAX_TOOL_CALLS=12
AI_MAX_TOOL_CALLS_PER_ROUND=6
AI_MAX_PARALLEL_TOOL_CALLS=4
AI_MAX_CONTEXT_CHARS=180000
AI_MAX_TOOL_RESULT_CHARS=80000
AI_MAX_ANSWER_CHARS=30000
AI_MAX_OUTPUT_TOKENS=6000
# AI_TEMPERATURE=0.2
AI_CITATION_REPAIR_ATTEMPTS=1
AI_TOOL_SELECTION_MAX_TOOLS=18
AI_TOOL_SELECTION_HARD_MAX_TOOLS=30
AI_STREAMING_ENABLED=true
AI_NON_STREAMING_ENABLED=true
AI_DEBUG_API_ENABLED=true
AI_PREFETCH_PORTFOLIO_SUMMARY=false

# User-owned AI conversation persistence. Stop/cancel is reliable only inside
# one API process until a Redis-backed runtime registry is introduced.
AI_CONVERSATIONS_ENABLED=true
AI_CONVERSATION_HISTORY_MAX_MESSAGES=16
AI_CONVERSATION_HISTORY_MAX_CHARS=60000
AI_CONVERSATION_SINGLE_ACTIVE_GENERATION=true
AI_CONVERSATION_RUNTIME_MODE=single_process
AI_CONVERSATION_PARTIAL_CHECKPOINT_ENABLED=false
AI_CONVERSATION_PARTIAL_CHECKPOINT_SECONDS=3
AI_CONVERSATION_SOFT_DELETE_ENABLED=true
AI_CONVERSATION_RESTORE_ENABLED=true
AI_CONVERSATION_DEFAULT_PAGE_SIZE=30
AI_CONVERSATION_MAX_PAGE_SIZE=100
AI_MESSAGE_DEFAULT_PAGE_SIZE=50
AI_MESSAGE_MAX_PAGE_SIZE=200

# Versioned deterministic Rich AI Responses.
AI_RICH_CONTENT_ENABLED=true
AI_RICH_CONTENT_SCHEMA_VERSION=1
AI_RICH_CONTENT_AUTO_INSERT_ENABLED=true
AI_RICH_CONTENT_AUTO_INSERT_MAX_BLOCKS=2
AI_RICH_CONTENT_MAX_BLOCKS_PER_MESSAGE=6
AI_RICH_CONTENT_HARD_MAX_BLOCKS=10
AI_RICH_CONTENT_MAX_DOCUMENT_CHARS=100000
AI_RICH_CONTENT_MAX_BLOCK_DATA_CHARS=30000
AI_RICH_CONTENT_MAX_CHART_POINTS=500
AI_RICH_CONTENT_MAX_CHART_SERIES=5
AI_RICH_CONTENT_MAX_TABLE_ROWS=100
AI_RICH_CONTENT_MAX_TABLE_COLUMNS=12
AI_RICH_CONTENT_MAX_TIMELINE_ITEMS=30
AI_RICH_CONTENT_MAX_NEWS_SOURCES=10
AI_RICH_CONTENT_MAX_METRICS=16

# Incremental conversation summaries (server-owned model).
AI_SUMMARY_ENABLED=true
AI_SUMMARY_AUTOMATIC_ENABLED=true
AI_SUMMARY_PROVIDER=
AI_SUMMARY_MODEL=
AI_SUMMARY_TRIGGER_MESSAGE_COUNT=20
AI_SUMMARY_UNSUMMARIZED_MESSAGE_COUNT=8
AI_SUMMARY_TRIGGER_CHARS=50000
AI_SUMMARY_CONTEXT_RATIO=0.70
AI_SUMMARY_MAX_OUTPUT_TOKENS=2000
AI_SUMMARY_TIMEOUT_SECONDS=60
AI_SUMMARY_MAX_RETRIES=1
AI_SUMMARY_PROMPT_VERSION=1
AI_SUMMARY_MAX_SNAPSHOTS_PER_CONVERSATION=10

# Confirmed long-term memory. Inferred candidates remain proposed.
AI_MEMORY_ENABLED=true
AI_MEMORY_USE_IN_CONTEXT=true
AI_MEMORY_CANDIDATE_EXTRACTION_ENABLED=true
AI_MEMORY_EXTRACTION_MODEL=
AI_MEMORY_EXTRACTION_PROMPT_VERSION=1
AI_MEMORY_EXPLICIT_SAVE_REQUIRES_CONFIRMATION=false
AI_MEMORY_MAX_CANDIDATES_PER_MESSAGE=3
AI_MEMORY_MAX_ACTIVE_ITEMS=200
AI_MEMORY_CONTEXT_MAX_ITEMS=10
AI_MEMORY_CONTEXT_MAX_CHARS=6000
AI_MEMORY_SENSITIVE_STORAGE_ENABLED=false

# User-confirmed investment decisions; no automatic trade execution.
AI_INVESTMENT_DECISIONS_ENABLED=true
AI_INVESTMENT_DECISION_DRAFT_SUGGESTIONS=false
AI_INVESTMENT_DECISION_MAX_EVIDENCE=30
AI_INVESTMENT_DECISION_REVIEW_DUE_ENABLED=true

# Optional Exa public-web search for AI chat. The key is server-only; leaving
# EXA_ENABLED=false or EXA_API_KEY empty keeps all existing internal AI usable.
EXA_ENABLED=false
EXA_API_BASE=https://api.exa.ai
EXA_API_KEY=
EXA_SEARCH_ENABLED=true
EXA_DEEP_SEARCH_ENABLED=true
EXA_DEFAULT_WEB_ACCESS_MODE=off
EXA_SEARCH_DEFAULT_TYPE=auto
EXA_SEARCH_MAX_QPS=5
EXA_SEARCH_TIMEOUT_SECONDS=30
EXA_SEARCH_MAX_RETRIES=2
EXA_SEARCH_DEFAULT_RESULTS=8
EXA_SEARCH_HARD_MAX_RESULTS=10
EXA_AGENT_TIMEOUT_SECONDS=900
EXA_AGENT_POLL_INTERVAL_SECONDS=2
EXA_AGENT_MAX_CONCURRENCY=2
EXA_DEEP_MINIMAL_ENABLED=true
EXA_DEEP_LOW_ENABLED=true
EXA_DEEP_MEDIUM_ENABLED=true
EXA_DEEP_HIGH_ENABLED=true
EXA_DEEP_XHIGH_ENABLED=true
EXA_DEEP_HIGH_CONFIRMATION_REQUIRED=true
EXA_DEEP_XHIGH_CONFIRMATION_REQUIRED=true
EXA_MAX_SEARCH_CALLS_PER_AI_REQUEST=3
EXA_MAX_COST_PER_AI_REQUEST_USD=1.25
# Blank disables the cross-request daily dollar cap; per-answer limits remain.
EXA_MAX_COST_PER_USER_DAY_USD=
EXA_DEEP_MAX_ACTIVE_RUNS_PER_USER=1
EXA_DEEP_MAX_ACTIVE_RUNS_GLOBAL=2
EXA_DEEP_HIGH_MAX_PER_USER_DAY=
EXA_DEEP_XHIGH_MAX_PER_USER_DAY=
EXA_QUERY_LOGGING_ENABLED=false
EXA_CACHE_ENABLED=true
EXA_AUDIT_ENABLED=true
EXA_METRICS_ENABLED=true
EXA_BLOCKED_DOMAINS=
EXA_TRUSTED_MEDIA_DOMAINS=reuters.com,bloomberg.com,apnews.com,ft.com,wsj.com,nikkei.com,cnbc.com
EXA_ALLOWED_ROLES=user,admin
# IBKR Client Portal Gateway (read-only; manual position sync on /ibkr)
IBKR_CP_ENABLED=false
IBKR_CP_BASE_URL=https://127.0.0.1:5000/v1/api
# Optional default account for Gateway position sync. Empty = single-account sessions
# are used automatically; multi-account sessions fail explicitly instead of guessing.
IBKR_CP_ACCOUNT_ID=
IBKR_CP_LOGIN_URL=https://localhost:5000
IBKR_CP_VERIFY_SSL=false
IBKR_CP_CONNECT_TIMEOUT_SECONDS=5
IBKR_CP_READ_TIMEOUT_SECONDS=30
IBKR_USERNAME_HINT=
IBKR_CREDENTIAL_ENCRYPTION_KEY=
IBKR_LOGIN_BROWSER_EXECUTABLE=/usr/bin/chromium
IBKR_LOGIN_TIMEOUT_SECONDS=150

# IBKR Flex Web Service. Never expose these values to the browser.
IBKR_FLEX_ENABLED=false
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
IBKR_FLEX_BASE_URL=https://ndcdyn.interactivebrokers.com/AccountManagement/FlexWebService
IBKR_FLEX_TIMEOUT_SECONDS=60

# Mandatory fail-closed Xray/VLESS egress. Keep socks5h for remote DNS resolution.
IBKR_PROXY_URL=socks5h://127.0.0.1:10808

# Server-only US macroeconomic time series. Never expose this key to the browser.
ALPHA_VANTAGE_ENABLED=false
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
ALPHA_VANTAGE_DAILY_REQUEST_LIMIT=25
ALPHA_VANTAGE_RESERVED_REQUESTS=3
ALPHA_VANTAGE_REQUEST_INTERVAL_SECONDS=15
ALPHA_VANTAGE_TIMEOUT_SECONDS=30
ALPHA_VANTAGE_MAX_RETRIES=3
ALPHA_VANTAGE_MACRO_SYNC_ENABLED=true
ALPHA_VANTAGE_MACRO_SYNC_HOUR_UTC=08
ALPHA_VANTAGE_MACRO_HISTORY_REFRESH_DAYS=7
# Container deployments may set this to the private stock-monitor_default gateway.
IBKR_DOCKER_BRIDGE_GATEWAY=

# Crypto public market data (Binance public endpoints only; no API key exists
# for this integration). Collection jobs stay disabled until explicitly enabled.
CRYPTO_BINANCE_SPOT_BASE_URL=https://api.binance.com
CRYPTO_BINANCE_USDM_BASE_URL=https://fapi.binance.com
CRYPTO_BINANCE_TIMEOUT_SECONDS=15
CRYPTO_BINANCE_MAX_RETRIES=2
CRYPTO_PUBLIC_ENABLED=false
CRYPTO_SPOT_UNIVERSE=BTCUSDT,ETHUSDT
CRYPTO_USDM_UNIVERSE=BTCUSDT,ETHUSDT
CRYPTO_CANDLE_HISTORY_DAYS=365
CRYPTO_CANDLE_SYNC_INTERVALS=1h,4h,1d
CRYPTO_LATEST_TTL_SECONDS=60
CRYPTO_LATEST_STALE_SECONDS=180
CRYPTO_COINGECKO_ENABLED=false
CRYPTO_COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
CRYPTO_COINGECKO_API_KEY=
CRYPTO_COINGECKO_REFRESH_HOURS=24
CRYPTO_COINGECKO_UNIVERSE=bitcoin,ethereum
